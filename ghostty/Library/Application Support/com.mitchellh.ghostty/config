command = /run/current-system/sw/bin/nu

# `detect` rather than `nushell`: explicitly naming nushell breaks
# `ghostty +new-window -e` (ghostty-org/ghostty#12378).
shell-integration = detect
# ssh-env: send TERM=xterm-256color to remote hosts, which mostly lack
# xterm-ghostty terminfo (tilde.town's signup exits 1 on it).
shell-integration-features = ssh-env

mouse-hide-while-typing = true

# custom styling
background-opacity = .65

background-blur = macos-glass-regular

unfocused-split-opacity = .95

## ghostty opens maximized
maximize = true

## Title
title = "Terminal"

focus-follows-mouse = true

quit-after-last-window-closed = true

macos-titlebar-style = tabs

macos-titlebar-proxy-icon = hidden

auto-update = download

auto-update-channel = tip

font-family = Maple Mono NF

font-size = 15

background = #000000
foreground = #ffffff
